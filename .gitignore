# ========================================
# Project-specific
# ========================================

# Cloudflare configuration (contains secrets)
wrangler.jsonc

# Data pipeline outputs
updater/data/
updater/log/

# New-game discovery pipeline's bookkeeping/PR-review files live in
# discovery-data/ (project root, NOT under updater/data/) and are git-tracked
# by default -- a negation pattern (!) cannot re-include files inside a
# directory that is itself gitignored (updater/data/ above), so they can't
# live there.

# Generated data files
**/games*.json
**/id-map.json


